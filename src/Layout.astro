---
import './styles.css';
import {
  DRAFT, CONTACT, HTML_LANG, LOCALES, DEFAULT_LANG, FALLBACK_SITE,
  hrefFor, profileOf, t, type Lang,
} from './site';

interface Props {
  lang: Lang;
  /** Rute logis tanpa prefiks bahasa, mis. '/about'. Dipakai untuk nav aktif + hreflang. */
  path: string;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  /** Halaman utilitas (sukses/galat form): selalu noindex, tidak masuk sitemap. */
  noindex?: boolean;
}

const { lang, path, title, description, jsonLd, noindex } = Astro.props;
const p = profileOf(lang);
const tr = t(lang);
const other: Lang = lang === 'en' ? 'id' : 'en';
const site = Astro.site ?? FALLBACK_SITE;
const canonical = new URL(hrefFor(lang, path), site);
const ogImage = new URL(`/og/og-${lang}.png`, site);
const initials = p.name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const year = new Date().getFullYear();

const nav = [
  { key: 'nav.about', to: '/about' },
  { key: 'nav.projects', to: '/projects' },
  { key: 'nav.cv', to: '/cv' },
  { key: 'nav.contact', to: '/contact' },
] as const;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070b11" media="(prefers-color-scheme: dark)" />

    {/* Konten yang belum diverifikasi tidak boleh terindeks. Penjaga otomatis, bukan ingatan. */}
    {(DRAFT || noindex) && <meta name="robots" content="noindex, nofollow" />}

    {!noindex && LOCALES.map((l) => (
      <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(hrefFor(l, path), site).href} />
    ))}
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={new URL(hrefFor(DEFAULT_LANG, path), site).href} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={p.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={HTML_LANG[lang].replace('-', '_')} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${p.name} — ${p.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    {/* Satu-satunya skrip render-blocking: ±150 byte, mencegah kedipan tema. */}
    <script is:inline>
      try {
        var s = localStorage.getItem('theme');
        if (s === 'dark' || s === 'light') document.documentElement.dataset.theme = s;
      } catch (e) {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{tr('ui.skip')}</a>
    {DRAFT && <p class="banner">{tr('ui.draft')}</p>}

    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={hrefFor(lang, '/')}>
          <span class="monogram" aria-hidden="true">{initials}</span>
          <span>
            {p.name}
            <span class="brand-sub">{p.headline}</span>
          </span>
        </a>

        <nav class="site-nav" aria-label={tr('nav.label')}>
          {nav.map((item) => (
            <a href={hrefFor(lang, item.to)} aria-current={path === item.to ? 'page' : undefined}>
              {tr(item.key)}
            </a>
          ))}
          <span class="nav-sep" aria-hidden="true"></span>
          <a
            class="lang-switch"
            href={hrefFor(other, path)}
            hreflang={HTML_LANG[other]}
            rel="alternate"
            lang={HTML_LANG[other]}
            title={tr('ui.switchLang')}
          >
            {other.toUpperCase()}
            <span class="sr-only"> — {tr('ui.switchLang')}</span>
          </a>
          <button
            id="theme-toggle"
            class="iconbtn"
            type="button"
            aria-label={tr('ui.theme')}
            data-labels={JSON.stringify({
              auto: tr('ui.themeAuto'),
              light: tr('ui.themeLight'),
              dark: tr('ui.themeDark'),
            })}
          >
            <svg class="i-auto" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.75a6.25 6.25 0 0 0 0 12.5z" fill="currentColor" />
            </svg>
            <svg class="i-light" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="8" cy="8" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path
                d="M8 .8v2M8 13.2v2M.8 8h2M13.2 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4"
                stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
              />
            </svg>
            <svg class="i-dark" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1z"
                fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
              />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <h3>{p.name}</h3>
            <p class="muted" style="max-width:38ch">{p.positioning}</p>
          </div>
          <div>
            <h3>{tr('nav.label')}</h3>
            <ul class="foot-links">
              {nav.map((item) => <li><a href={hrefFor(lang, item.to)}>{tr(item.key)}</a></li>)}
            </ul>
          </div>
          <div>
            <h3>{tr('cv.contact')}</h3>
            <ul class="foot-links">
              {CONTACT.social.map((s) => (
                <li><a href={s.url} rel="me noopener">{s.label}</a></li>
              ))}
              <li><a href="/resume.json">resume.json</a></li>
              <li><a href={hrefFor(other, path)} hreflang={HTML_LANG[other]} rel="alternate">{tr('ui.switchLang')}</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {year} {p.name}</span>
          <span class="tnum">{p.location}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var L = JSON.parse(btn.dataset.labels || '{}');
        var order = ['auto', 'light', 'dark'];
        function label() {
          var cur = root.dataset.theme || 'auto';
          btn.setAttribute('aria-label', L[cur] || btn.getAttribute('aria-label'));
          btn.setAttribute('title', L[cur] || '');
        }
        label();
        btn.addEventListener('click', function () {
          var cur = root.dataset.theme || 'auto';
          var next = order[(order.indexOf(cur) + 1) % 3];
          if (next === 'auto') {
            delete root.dataset.theme;
            try { localStorage.removeItem('theme'); } catch (e) {}
          } else {
            root.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch (e) {}
          }
          label();
        });
      })();
    </script>
  </body>
</html>

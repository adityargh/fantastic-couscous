---
import { render, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import {
  FALLBACK_SITE, hrefFor, profileOf, shotSrc, SHOT_W, SHOT_H, t, type Lang,
} from './site';

interface Props { entry: CollectionEntry<'projects'>; lang: Lang }
const { entry, lang } = Astro.props;

const { Content, headings } = await render(entry);
const p = profileOf(lang);
const tr = t(lang);
const d = entry.data;
const site = Astro.site ?? FALLBACK_SITE;
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: lang,
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: p.name, jobTitle: p.headline },
  url: new URL(hrefFor(lang, `/projects/${d.slug}`), site).href,
  // Gambar utama artikel adalah tangkapan pertamanya, bukan kartu OG generik —
  // pratinjau tautan jadi menunjukkan sistem yang dibicarakan.
  image: new URL(shotSrc(d.slug, d.shots[0].file), site).href,
};

const expand =
  '<svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 2H2v4M10 14h4v-4M14 6V2h-4M2 10v4h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout
  lang={lang}
  path={`/projects/${d.slug}`}
  title={`${d.title} — ${p.name}`}
  description={d.description}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <article class="section">
      <div class="section-head">
        <p class="eyebrow eyebrow-n">{tr('nav.projects')}</p>
        <ul class="chips">{d.tags.map((tag) => <li class="chip chip-brand">{tag}</li>)}</ul>
      </div>

      <h1 style="max-width:26ch">{d.title}</h1>
      <p class="lede" style="margin-block:var(--s4) var(--s6)">{d.description}</p>

      <div class="case-facts" style="margin-bottom:var(--s7)">
        <div class="case-fact">
          <span class="eyebrow">{tr('proj.result')}</span>
          <strong>{d.headline}</strong>
        </div>
        <div class="case-fact">
          <span class="eyebrow">{tr('proj.system')}</span>
          <strong>{d.system}</strong>
        </div>
        <div class="case-fact">
          <span class="eyebrow">{tr('proj.role')}</span>
          <strong>{d.role}</strong>
        </div>
        <div class="case-fact">
          <span class="eyebrow">{tr('proj.period')}</span>
          <strong class="tnum">{d.period}</strong>
        </div>
      </div>

      {/* Galeri berdiri di luar kolom prosa: tangkapan 1280 px pantas mendapat
          lebar penuh, dan menyisipkannya di tengah teks akan memotong alur baca. */}
      <section class="gallery" aria-labelledby="interface">
        <div class="gallery-head">
          <h2 id="interface">{tr('proj.interface')}</h2>
          <p class="muted">{tr('proj.interfaceHint')}</p>
        </div>

        {d.reconstructed && <p class="notice notice-thin">{tr('proj.reconstructed')}</p>}

        <div class="shots">
          {d.shots.map((s, i) => (
            <figure class="shot">
              {/* Tautan ke berkas PNG-nya sendiri: pembesaran bawaan peramban,
                  dapat di-zoom, dapat dibuka di tab baru, dan tetap bekerja
                  tanpa satu baris JavaScript pun. */}
              <a class="shot-frame" href={shotSrc(d.slug, s.file)} target="_blank" rel="noopener">
                <img
                  src={shotSrc(d.slug, s.file)}
                  width={SHOT_W}
                  height={SHOT_H}
                  loading="lazy"
                  decoding="async"
                  alt={s.alt}
                />
                <span class="shot-zoom" aria-hidden="true">
                  <Fragment set:html={expand} />
                </span>
                <span class="sr-only"> — {tr('proj.openShot')} {s.title}</span>
              </a>
              <figcaption>
                <span class="shot-n tnum">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <b>{s.title}</b>
                  {s.caption}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <div class="case-layout">
        <div class="prose">
          <Content />

          <h2 id="measured">{tr('proj.measured')}</h2>
          <p class="muted">{tr('proj.measuredHint')}</p>
          <ul class="measured">
            {d.measured.map((m) => <li>{m}</li>)}
          </ul>

          {d.metrics && d.metrics.length > 0 && (
            <>
              <h2 id="outcome">{tr('proj.metrics')}</h2>
              <div class="tablewrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">{tr('proj.metrics')}</th>
                      <th scope="col">{tr('proj.before')}</th>
                      <th scope="col">{tr('proj.after')}</th>
                      <th scope="col">{tr('proj.delta')}</th>
                      <th scope="col">{tr('proj.window')}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {d.metrics.map((m) => (
                      <tr>
                        <td>{m.name}</td><td>{m.before}</td><td>{m.after}</td>
                        <td>{m.delta}</td><td>{m.window}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}

          <p style="margin-top:var(--s7)">
            <a class="backlink" href={hrefFor(lang, '/projects')}>&larr; {tr('proj.back')}</a>
          </p>
        </div>

        <nav class="toc" aria-labelledby="toc-h">
          <h2 id="toc-h">{tr('sec.contents')}</h2>
          <ol>
            <li><a href="#interface">{tr('proj.interface')}</a></li>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            <li><a href="#measured">{tr('proj.measured')}</a></li>
          </ol>
        </nav>
      </div>
    </article>
  </div>
</Layout>

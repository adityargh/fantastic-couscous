---
import Layout from '../Layout.astro';
import { DEFAULT_LANG, hrefFor, profileOf, t } from '../site';

const lang = DEFAULT_LANG;
const p = profileOf(lang);
const tr = t(lang);

const links = [
  { key: 'nav.about', to: '/about' },
  { key: 'nav.projects', to: '/projects' },
  { key: 'nav.cv', to: '/cv' },
  { key: 'nav.contact', to: '/contact' },
] as const;
---
<Layout lang={lang} path="/" title={`404 — ${p.name}`} description={tr('ui.notFoundBody')} noindex>
  <div class="wrap">
    <section class="section">
      <div class="section-head">
        <p class="eyebrow eyebrow-n">404</p>
        <h1>{tr('ui.notFound')}</h1>
      </div>
      <p class="lede">{tr('ui.notFoundBody')}</p>
      <p class="btn-row" style="margin-top:var(--s5)">
        <a class="btn btn-primary" href={hrefFor(lang, '/')}>{tr('ui.home')}</a>
      </p>
      <ul class="linklist" style="margin-top:var(--s6)">
        {links.map((l) => <li><a href={hrefFor(lang, l.to)}>{tr(l.key)}</a></li>)}
      </ul>
    </section>
  </div>
</Layout>

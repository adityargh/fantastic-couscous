---
import Layout from '../../Layout.astro';
import { CONTACT, FALLBACK_SITE, langPaths, hrefFor, profileOf, t, type Lang } from '../../site';

export const getStaticPaths = langPaths;
type Props = { lang: Lang };

const { lang } = Astro.props;
const p = profileOf(lang);
const tr = t(lang);
const site = Astro.site ?? FALLBACK_SITE;
const key = CONTACT.web3formsKey.trim();
const email = CONTACT.email.trim();
const copied = lang === 'id' ? 'Alamat email disalin' : 'Email address copied';
---
<Layout
  lang={lang}
  path="/contact"
  title={`${tr('nav.contact')} — ${p.name}`}
  description={p.contactIntro}
>
  <div class="wrap">
    <section class="section">
      <div class="section-head">
        <p class="eyebrow eyebrow-n">{tr('nav.contact')}</p>
        <h1>{tr('cta.title')}</h1>
      </div>
      <p class="lede" style="margin-bottom:var(--s6)">{p.contactIntro}</p>

      <div class="contact-grid">
        {email && (
          <section class="contact-direct" aria-labelledby="direct-h">
            <h2 id="direct-h" class="eyebrow">{tr('form.direct')}</h2>
            <a class="mail" href={`mailto:${email}`}>
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
                <rect x="1.75" y="3.75" width="14.5" height="10.5" rx="2" fill="none"
                  stroke="currentColor" stroke-width="1.5" />
                <path d="m2.5 5 6.5 4.5L15.5 5" fill="none" stroke="currentColor"
                  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{email}</span>
            </a>
            <p class="hint" style="display:block">{tr('form.directHint')}</p>
            <p>
              <button class="btn btn-ghost btn-sm" type="button" id="copy-mail"
                data-mail={email} data-done={copied} hidden>
                <svg width="15" height="15" viewBox="0 0 15 15" aria-hidden="true" focusable="false">
                  <rect x="4.75" y="4.75" width="8.5" height="8.5" rx="1.75" fill="none"
                    stroke="currentColor" stroke-width="1.4" />
                  <path d="M10.25 4.75v-1a1.5 1.5 0 0 0-1.5-1.5h-5a1.5 1.5 0 0 0-1.5 1.5v5a1.5 1.5 0 0 0 1.5 1.5h1"
                    fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
                <span data-label>{lang === 'id' ? 'Salin alamat' : 'Copy address'}</span>
              </button>
            </p>
            <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
          </section>
        )}

        <section class="contact-form" aria-labelledby="form-h">
          <h2 id="form-h" class="eyebrow">{tr('form.send')}</h2>

          {key ? (
            <form action="https://api.web3forms.com/submit" method="POST" class="stack stack-lg">
              <input type="hidden" name="access_key" value={key} />
              <input type="hidden" name="subject" value={`Kontak baru dari website ${p.name}`} />
              <input type="hidden" name="from_name" value={p.name} />
              <input type="hidden" name="redirect" value={new URL(hrefFor(lang, '/contact/success'), site).href} />

              {/* Honeypot. Web3Forms menolak kiriman yang mengisi field ini. */}
              <div class="hp" aria-hidden="true">
                <label for="botcheck">Leave this empty</label>
                <input id="botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
              </div>

              <div class="field">
                <label for="name">
                  {tr('form.name')} <span class="req" aria-hidden="true">*</span>
                  <span class="sr-only"> ({tr('form.required')})</span>
                </label>
                <input id="name" name="name" type="text" required autocomplete="name" maxlength="80" />
              </div>

              <div class="field">
                <label for="email">
                  {tr('form.email')} <span class="req" aria-hidden="true">*</span>
                  <span class="sr-only"> ({tr('form.required')})</span>
                </label>
                <input id="email" name="email" type="email" required autocomplete="email" maxlength="120" />
              </div>

              <div class="field">
                <label for="message">
                  {tr('form.message')} <span class="req" aria-hidden="true">*</span>
                  <span class="sr-only"> ({tr('form.required')})</span>
                </label>
                <textarea id="message" name="message" required minlength="20" maxlength="4000"
                  aria-describedby="message-hint"></textarea>
                <p id="message-hint" class="hint">
                  <span>{tr('form.help')}</span>
                  <span id="counter" class="tnum" aria-hidden="true">0 / 4000</span>
                </p>
              </div>

              <p><button class="btn btn-primary" type="submit">{tr('form.send')}</button></p>
              <p class="notice">{tr('form.expect')}</p>
            </form>
          ) : (
            <p class="notice notice-warn">{tr('form.unconfigured')}</p>
          )}
        </section>
      </div>

      <div style="margin-top:var(--s7)">
        <p class="eyebrow" style="margin-bottom:var(--s3)">{tr('form.alt')}</p>
        <ul class="linklist">
          {CONTACT.social.map((s) => <li><a href={s.url} rel="me noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var box = document.getElementById('message');
      var out = document.getElementById('counter');
      if (box && out) {
        var max = box.getAttribute('maxlength') || 4000;
        var tick = function () { out.textContent = box.value.length + ' / ' + max; };
        box.addEventListener('input', tick);
        tick();
      }

      // Tombol salin hanya muncul bila clipboard benar-benar tersedia —
      // tombol yang tidak bisa bekerja lebih buruk daripada tidak ada tombol.
      var btn = document.getElementById('copy-mail');
      if (!btn || !navigator.clipboard) return;
      btn.hidden = false;
      var label = btn.querySelector('[data-label]');
      var first = label.textContent;
      var status = document.getElementById('copy-status');
      var timer;
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.dataset.mail).then(function () {
          label.textContent = btn.dataset.done;
          if (status) status.textContent = btn.dataset.done;
          clearTimeout(timer);
          timer = setTimeout(function () {
            label.textContent = first;
            if (status) status.textContent = '';
          }, 2600);
        });
      });
    })();
  </script>
</Layout>

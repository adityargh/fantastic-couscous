---
import Layout from '../../Layout.astro';
import { langPaths, profileOf, hrefFor, t, type Lang } from '../../site';

export const getStaticPaths = langPaths;
type Props = { lang: Lang };

const { lang } = Astro.props;
const p = profileOf(lang);
const tr = t(lang);
---
<Layout
  lang={lang}
  path="/about"
  title={`${tr('sec.about')} — ${p.name}`}
  description={p.positioning}
>
  <div class="wrap">
    <section class="section">
      <div class="section-head">
        <p class="eyebrow eyebrow-n">{tr('sec.about')}</p>
        <h1>{p.name}</h1>
      </div>
      <p class="lede" style="margin-bottom:var(--s6)">{p.positioning}</p>
      <div class="prose">
        {p.about.map((para) => <p>{para}</p>)}
      </div>
    </section>

    {p.education.length > 0 && (
      <section class="section" aria-labelledby="edu">
        <div class="section-head">
          <p class="eyebrow eyebrow-n">{lang === 'id' ? 'Latar' : 'Background'}</p>
          <h2 id="edu">{tr('sec.education')}</h2>
        </div>
        <div class="tablewrap">
          <table>
            <tbody>
              {p.education.map((e) => (
                <tr>
                  <td><strong>{e.url ? <a href={e.url} rel="noopener">{e.name}</a> : e.name}</strong></td>
                  <td>{e.institution}</td>
                  <td class="dim tnum">{e.period ?? e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="section">
      <div class="btn-row">
        <a class="btn btn-primary" href={hrefFor(lang, '/projects')}>{tr('hero.caseStudies')}</a>
        <a class="btn btn-ghost" href={hrefFor(lang, '/contact')}>{tr('cta.button')}</a>
      </div>
    </section>
  </div>
</Layout>

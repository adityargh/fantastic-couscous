---
import Layout from '../../Layout.astro';
import {
  CONTACT, langPaths, profileOf, periodLabel, tenures, durationLabel,
  monthsBetween, t, type Lang,
} from '../../site';

export const getStaticPaths = langPaths;
type Props = { lang: Lang };

const { lang } = Astro.props;
const p = profileOf(lang);
const tr = t(lang);
const career = tenures(p.experience);
const email = CONTACT.email.trim();
const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Layout
  lang={lang}
  path="/cv"
  title={`${tr('cv.title')} — ${p.name}`}
  description={`${tr('cv.title')} ${p.name} — ${p.headline}. ${p.positioning}`}
>
  <div class="wrap">
    <section class="section cv">
      <p class="notice no-print" style="margin-bottom:var(--s4)">{tr('cv.hint')}</p>
      <p class="no-print btn-row" style="margin-bottom:var(--s7)">
        <a class="btn btn-primary" href={`/cv/cv-${lang}.pdf`} download>{tr('cv.download')}</a>
        <button class="btn btn-ghost" type="button" id="print-cv" hidden>{tr('cv.print')}</button>
      </p>

      <header>
        <h1>{p.name}</h1>
        <p class="cv-title">{p.headline}</p>
        <p class="cv-head">
          <span>{p.location}</span>
          {email && <a href={`mailto:${email}`}>{email}</a>}
          {CONTACT.social.map((s) => <a href={s.url} rel="noopener">{short(s.url)}</a>)}
        </p>
      </header>

      <section>
        <h2>{tr('cv.profile')}</h2>
        <p class="cv-profile">{p.positioning}</p>
        <p class="cv-disciplines">{p.disciplines.join(' · ')}</p>
      </section>

      <section>
        <h2>{tr('sec.experience')}</h2>
        {career.map((c) => (
          <div class="cv-tenure">
            <p class="cv-company">
              {c.company}{c.industry ? ` · ${c.industry}` : ''} · {durationLabel(c.months, lang)}
            </p>
            {c.roles.map((r) => (
              <div class="cv-role">
                <p class="when">
                  {periodLabel(r.start, r.end, lang)}<br />
                  <span class="dim">{durationLabel(monthsBetween(r.start, r.end), lang)}</span>
                </p>
                <div>
                  <h3>{r.title}</h3>
                  <p class="where">{r.location}{r.scope ? ` · ${r.scope}` : ''}</p>
                  <ul>{r.achievements.map((a) => <li>{a}</li>)}</ul>
                </div>
              </div>
            ))}
          </div>
        ))}
      </section>

      <section>
        <h2>{tr('sec.skills')}</h2>
        <ul class="cv-list">
          {p.skills.map((g) => (
            <li><strong>{g.domain}:</strong> {g.items.map((i) => i.name).join(', ')}</li>
          ))}
        </ul>
      </section>

      {p.education.length > 0 && (
        <section>
          <h2>{tr('sec.education')}</h2>
          <ul class="cv-list">
            {p.education.map((e) => (
              <li><strong>{e.name}</strong> — {e.institution} <span class="dim tnum">({e.period ?? e.year})</span></li>
            ))}
          </ul>
        </section>
      )}
    </section>
  </div>

  <script is:inline>
    // Tombol cetak hanya muncul bila JS hidup — tombol mati lebih buruk
    // daripada tidak ada tombol. Unduh PDF tetap bekerja tanpa JS.
    (function () {
      var b = document.getElementById('print-cv');
      if (!b) return;
      b.hidden = false;
      b.addEventListener('click', function () { window.print(); });
    })();
  </script>
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '../../../Layout.astro';
import {
  langPaths, hrefFor, profileOf, shotSrc, SHOT_W, SHOT_H, t, type Lang,
} from '../../../site';

export const getStaticPaths = langPaths;
type Props = { lang: Lang };

const { lang } = Astro.props;
const p = profileOf(lang);
const tr = t(lang);
const cases = (await getCollection('projects', (e) => e.data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order);

const arrow =
  '<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 7h9M7.5 3.5 11 7l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Layout
  lang={lang}
  path="/projects"
  title={`${tr('nav.projects')} — ${p.name}`}
  description={lang === 'id'
    ? `Studi kasus operasional ${p.name}: masalah, pendekatan, indikator yang diukur, dan tampilan antarmuka sistemnya.`
    : `Operations case studies by ${p.name}: the problem, the approach, the indicators measured, and the interface behind each system.`}
>
  <div class="wrap">
    <section class="section">
      <div class="section-head">
        <p class="eyebrow eyebrow-n">{tr('nav.projects')}</p>
        <h1>{tr('proj.all')}</h1>
        {cases.length > 0 && <p class="eyebrow tnum">{cases.length} {tr('proj.count')}</p>}
      </div>
      {cases.length > 0 && <p class="lede">{tr('proj.catalogLede')}</p>}

      {/* Pemberitahuan rekonstruksi berdiri SEKALI di kepala katalog, bukan
          diulang pada setiap kartu — dan setiap gambar juga membawa penandanya
          sendiri di dalam bingkai. */}
      {cases.some((c) => c.data.reconstructed) && (
        <p class="notice notice-thin">{tr('proj.reconstructed')}</p>
      )}

      {/* Keadaan kosong adalah keadaan yang SAH di sini (ADR-014), jadi ia
          dirancang, bukan dibiarkan jadi halaman putih. */}
      {cases.length === 0 && (
        <div class="empty">
          <h2>{tr('proj.emptyTitle')}</h2>
          <p>{tr('proj.emptyBody')}</p>
          <p class="btn-row">
            <a class="btn btn-primary" href={hrefFor(lang, '/cv')}>{tr('hero.downloadCv')}<Fragment set:html={arrow} /></a>
            <a class="btn btn-ghost" href={hrefFor(lang, '/about')}>{tr('nav.about')}</a>
          </p>
        </div>
      )}

      <div class="pcards">
        {cases.map((c) => (
          <article class="pcard">
            <a class="pcard-link" href={hrefFor(lang, `/projects/${c.data.slug}`)}>
              <span class="pcard-shot">
                <img
                  src={shotSrc(c.data.slug, c.data.shots[0].file)}
                  width={SHOT_W}
                  height={SHOT_H}
                  loading="lazy"
                  decoding="async"
                  alt={c.data.shots[0].alt}
                />
                <span class="pcard-tag">{c.data.system}</span>
                <span class="pcard-count tnum">{c.data.shots.length} {tr('proj.screens')}</span>
              </span>

              <span class="pcard-body">
                <span class="card-metric">{c.data.headline}</span>
                <h2>{c.data.title}</h2>
                <span class="pcard-desc">{c.data.description}</span>
                <span class="pcard-meta tnum">{c.data.period} · {c.data.role.split(' · ')[0]}</span>
                <span class="card-go">{tr('proj.read')}<Fragment set:html={arrow} /></span>
              </span>
            </a>
            <ul class="chips pcard-chips">{c.data.tags.map((tag) => <li class="chip">{tag}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

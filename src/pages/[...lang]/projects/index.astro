---
import { getCollection } from 'astro:content';
import Layout from '../../../Layout.astro';
import { langPaths, hrefFor, profileOf, t, type Lang } from '../../../site';

export const getStaticPaths = langPaths;
type Props = { lang: Lang };

const { lang } = Astro.props;
const p = profileOf(lang);
const tr = t(lang);
const cases = (await getCollection('projects', (e) => e.data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order);
---
<Layout
  lang={lang}
  path="/projects"
  title={`${tr('nav.projects')} — ${p.name}`}
  description={lang === 'id'
    ? `Studi kasus operasional ${p.name}: masalah, pendekatan, dan hasil yang terukur.`
    : `Operations case studies by ${p.name}: the problem, the approach, and the measured result.`}
>
  <div class="wrap">
    <section class="band">
      <div class="band-head">
        <p class="eyebrow">{tr('nav.projects')}</p>
        <h1>{tr('proj.all')}</h1>
      </div>
      <div class="cards">
        {cases.map((c) => (
          <a class="card" href={hrefFor(lang, `/projects/${c.data.slug}`)}>
            <p class="result">{c.data.headline}</p>
            <h3>{c.data.title}</h3>
            <p>{c.data.description}</p>
            <p class="tags">{c.data.tags.map((tag) => <span class="tag">{tag}</span>)}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
